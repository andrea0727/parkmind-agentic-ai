# ==========================================
# ParkMind - Environment Configuration
# ==========================================


# ------------------------------------------
# LLM Provider
# ------------------------------------------

OPENAI_API_KEY=

# ANTHROPIC_API_KEY=
# ELICIT_MODEL=claude-haiku-4-5-20251001
# GOOGLE_API_KEY=


# ------------------------------------------
# Langfuse - Observability & Evaluation
# ------------------------------------------

# Public key used to authenticate with Langfuse
LANGFUSE_PUBLIC_KEY=

# Secret key used to authenticate with Langfuse
LANGFUSE_SECRET_KEY=

# Langfuse server endpoint
LANGFUSE_HOST=


# ------------------------------------------
# Database
# ------------------------------------------

# PostgreSQL connection string for ParkMind
DATABASE_URL=postgresql://parkmind:parkmind@localhost:5432/parkmind


# ------------------------------------------
# Theme Park Data APIs
# ------------------------------------------

# Base URL for theme park data and attraction information
THEMEPARKS_BASE_URL=https://api.themeparks.wiki/v1

# Base URL for weather data
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1


# ------------------------------------------
# Knowledge store and MCP (P0-24..P0-27)
# ------------------------------------------
# The values shown are the defaults; uncomment a line only to change it.

# LOAD CONTEXT transport: "in_process" (default) or "mcp" (reads data.* and
# knowledge.* through parkmind-mcp, started with
# `poetry run python scripts/run_mcp_server.py --http`; falls back in-process)
# PARKMIND_CONTEXT_TRANSPORT=in_process
# PARKMIND_MCP_URL=http://127.0.0.1:8765/mcp

# "pgvector" (semantic search; needs `docker compose up -d --build` and
# `poetry run python scripts/index_knowledge.py`) or "in_memory" (keyword only)
# PARKMIND_KNOWLEDGE_BACKEND=pgvector

# Local multilingual embedding model (fastembed); downloaded once with
# `poetry run python scripts/fetch_embedding_model.py`, then used offline
# PARKMIND_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# PARKMIND_EMBEDDING_CACHE=~/.cache/parkmind/fastembed


# ------------------------------------------
# Application
# ------------------------------------------

# Application environment
ENVIRONMENT=