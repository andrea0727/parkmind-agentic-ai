# ==========================================
# ParkMind - Environment Configuration
# ==========================================


# ------------------------------------------
# LLM Provider
# ------------------------------------------

# Anthropic key: reads the guests' messages (ELICIT) and writes the explanations.
# Without it the explanations use the deterministic template.
ANTHROPIC_API_KEY=
# ELICIT_MODEL=claude-haiku-4-5-20251001
# EXPLAIN_MODEL=  (defaults to ELICIT_MODEL)
# EXPLAIN_TIMEOUT_SECONDS=20  (per request; the guests wait at most 2 x (1 + retries) x this)
# EXPLAIN_SDK_RETRIES=0
# LLM calls one conversation (thread) may make, retries included (default 40). Past it
# elicit asks the guests to rephrase and explain writes the template: no more model calls.
# PARKMIND_LLM_CALLS_PER_THREAD=40


# ------------------------------------------
# Langfuse - Observability & Evaluation
# ------------------------------------------

# Tracing is off unless this is `langfuse`. Every graph run is then sent to Langfuse,
# masked first [C19]: no chat text, labels, corrections or accessibility data leave the
# process (ADR 0003). Off by default; `langfuse` needs the three settings below.
PARKMIND_TRACING=off

# Langfuse project keys and server. For the local stack (docker-compose.langfuse.yml),
# uncomment these: the stack creates this project and these keys on first start.
# LANGFUSE_PUBLIC_KEY=pk-lf-parkmind-local
# LANGFUSE_SECRET_KEY=sk-lf-parkmind-local
# LANGFUSE_BASE_URL=http://localhost:3000

# LangSmith tracing stays OFF. langchain-core traces every run on its own when this
# (or LANGCHAIN_TRACING_V2) is true, and that tracer never passes through ParkMind's
# masking [C19]: the graphs refuse to build while it is on (see ADR 0003).
# LangGraph Studio (`langgraph dev`) works with tracing off.
LANGSMITH_TRACING=false


# ------------------------------------------
# Database
# ------------------------------------------

# PostgreSQL connection string for ParkMind
DATABASE_URL=postgresql://parkmind:parkmind@localhost:5432/parkmind


# ------------------------------------------
# Theme Park Data APIs
# ------------------------------------------

# Base URL for theme park data and attraction information
THEMEPARKS_BASE_URL=https://api.themeparks.wiki/v1

# Base URL for weather data
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1


# ------------------------------------------
# Knowledge store and MCP
# ------------------------------------------
# The values shown are the defaults; uncomment a line only to change it.

# LOAD CONTEXT transport: "in_process" (default) or "mcp" (reads data.* and
# knowledge.* through parkmind-mcp, started with
# `poetry run python scripts/run_mcp_server.py --http`; falls back in-process)
# PARKMIND_CONTEXT_TRANSPORT=in_process
# PARKMIND_MCP_URL=http://127.0.0.1:8765/mcp
# Bearer token for the HTTP MCP server (32+ characters, no default). Without it
# the server only listens on loopback and has no authentication; with it every
# request must send it (the context client reads this same variable) and the
# server may listen on any --host. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# PARKMIND_MCP_TOKEN=
# planner.* calls per minute the HTTP server allows (they can trigger a park capture)
# PARKMIND_MCP_PLANNER_CALLS_PER_MINUTE=30

# "pgvector" (semantic search; needs `docker compose up -d --build` and
# `poetry run python scripts/index_knowledge.py`) or "in_memory" (keyword only)
# PARKMIND_KNOWLEDGE_BACKEND=pgvector

# Local multilingual embedding model (fastembed); downloaded once with
# `poetry run python scripts/fetch_embedding_model.py`, then used offline
# PARKMIND_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# PARKMIND_EMBEDDING_CACHE=~/.cache/parkmind/fastembed


# ------------------------------------------
# Application
# ------------------------------------------

# Application environment
ENVIRONMENT=

# Largest party the planner accepts (default 10). Above it the guests are asked to
# split the group instead of getting a plan.
# PARKMIND_MAX_PARTY_SIZE=10

# ------------------------------------------
# API auth (REQUIRED: `python server.py` refuses to start without them)
# ------------------------------------------

# Users as `name=password,name2=password2` (8+ chars, no commas). Keep this file out of git.
# PARKMIND_AUTH_USERS=alice=change-me-please

# Signing key for access tokens, at least 32 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# PARKMIND_JWT_SECRET=

# Token lifetime in hours (default 2): users sign in again after that
# PARKMIND_TOKEN_TTL_HOURS=2

# Caps that protect the LLM key, per 24 h (defaults shown). Per user also limited to 20 messages/min.
# PARKMIND_MESSAGES_PER_USER_DAY=300
# PARKMIND_MESSAGES_GLOBAL_DAY=2000

# Local demos only: 1 leaves every route open (the server prints a warning)
# PARKMIND_AUTH_DISABLED=

# Demo switches (never in a real deployment). The first two are honoured only with
# PARKMIND_DEMO=1; the server refuses to start with one of them set and no PARKMIND_DEMO.
# PARKMIND_DEMO=1
# PARKMIND_PLAN_FROM_STORED=1
# E2E_NOW=14:30
# Load the dev scenario when the container starts (docker-compose.yml already sets it)
# PARKMIND_SEED_DEMO=1
