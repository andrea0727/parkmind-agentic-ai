[importlinter]
root_package = parkmind
include_external_packages = True

# Boundary contract per project-folder-structure.md (baseline v2, "Boundary contract" section,
# updated by the [v2.1 · decided 2026-09-17] core/contracts/ decision) and CLAUDE.local.md
# "Non-negotiable boundaries":
#
#   core/contracts/, services/ports/, services/planning/, services/personalization/,
#   services/simulator/
#       must NOT import:
#       services/clients, services/use_cases, graph, agents, tools, api, ui,
#       langgraph, mcp, fastapi, streamlit, psycopg/sqlalchemy, any LLM SDK
#
#   services/use_cases/     may import ports + planning + personalization + clients
#   graph/, tools/, api/    may import use_cases and core.contracts only
#   agents/                 may import core.contracts, use_cases, tools.registry, LLM SDK
#
# Only the paths that currently exist in src/parkmind are listed as modules below;
# services/simulator/ will be added to this contract once it's created.

[importlinter:contract:core-forbidden-imports]
name = Deterministic core never imports adapters, frameworks or DB drivers
type = forbidden
source_modules =
    parkmind.core.contracts
    parkmind.services.planning
    parkmind.services.personalization
    parkmind.services.ports
forbidden_modules =
    parkmind.services.clients
    parkmind.services.use_cases
    parkmind.graph
    parkmind.agents
    parkmind.tools
    parkmind.api
    parkmind.ui
    langgraph
    mcp
    fastapi
    streamlit
    psycopg
    sqlalchemy
    langchain_anthropic
    anthropic

[importlinter:contract:use-cases-forbidden-imports]
name = use_cases wires ports/planning/personalization/clients only, never graph/agents/tools/api/ui
type = forbidden
source_modules =
    parkmind.services.use_cases
forbidden_modules =
    parkmind.graph
    parkmind.agents
    parkmind.tools
    parkmind.api
    parkmind.ui

[importlinter:contract:graph-tools-forbidden-imports]
name = graph and tools import use_cases and core.contracts only, never planning/personalization/clients directly
type = forbidden
source_modules =
    parkmind.graph
    parkmind.tools
forbidden_modules =
    parkmind.services.planning
    parkmind.services.personalization
    parkmind.services.clients
# Direct-import boundary only: use_cases is explicitly allowed to import clients
# (see the layer summary above), so graph/tools reaching clients *through*
# use_cases is fine -- only bypassing the use_cases layer is forbidden.
allow_indirect_imports = true

[importlinter:contract:agents-forbidden-imports]
name = agents import core.contracts, use_cases, tools.registry and the LLM SDK only, never planning/personalization/clients directly
type = forbidden
source_modules =
    parkmind.agents
forbidden_modules =
    parkmind.services.planning
    parkmind.services.personalization
    parkmind.services.clients
# Direct-import boundary only: see graph-tools-forbidden-imports above.
allow_indirect_imports = true
